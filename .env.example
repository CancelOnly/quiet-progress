PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Defina uma senha real no .env local. Não commitar .env.
APP_PASSWORD=trocar-essa-senha
SESSION_SECRET=trocar-esse-segredo-longo-com-40-ou-mais-caracteres
SESSION_MAX_AGE_DAYS=30

PUBLIC_BASE_URL=http://localhost:3000

# Caminho opcional do banco SQLite ativo.
# Se vazio/omitido, usa process.cwd()/quiet_progress.db.
# Em PM2/systemd, prefira caminho absoluto.
DB_PATH=

# PWA / Web Push — opcional. Gere com: npm run generate:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@example.com
PUSH_SCHEDULER_INTERVAL_MS=30000

AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_RETENTION_DAYS=30
