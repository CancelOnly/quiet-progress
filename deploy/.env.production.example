# Quiet Progress — produção via Cloudflare Tunnel
# Copie para /opt/quiet-progress/.env e edite os valores.
# NÃO commitar este arquivo com segredos reais.

PORT=3000
HOST=127.0.0.1
NODE_ENV=production

APP_PASSWORD=troque-por-uma-senha-forte
SESSION_SECRET=troque-por-um-segredo-longo-aleatorio-com-40-ou-mais-caracteres
SESSION_MAX_AGE_DAYS=30

PUBLIC_BASE_URL=https://quiet.seu-dominio.com

DB_PATH=/opt/quiet-progress/quiet_progress.db

# Web Push / PWA
# Gere com: npm run generate:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@example.com

# Opcional
PUSH_SCHEDULER_INTERVAL_MS=30000
